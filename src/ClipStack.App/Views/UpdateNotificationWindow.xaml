<Window x:Class="ClipStack.Views.UpdateNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipStack update"
        Icon="/ClipStack;component/Assets/clipstack.ico"
        Width="390"
        Height="196"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Loaded="OnLoaded"
        AutomationProperties.Name="ClipStack update ready">
  <Window.Resources>
    <Style x:Key="NotificationButton" TargetType="Button">
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryNotificationButton"
           TargetType="Button"
           BasedOn="{StaticResource NotificationButton}">
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Opacity" Value="0.9" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Border CornerRadius="8"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource BgBrush}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="22"
                          Direction="270"
                          ShadowDepth="6"
                          Opacity="0.35"
                          Color="#FF000000" />
      </Border.Effect>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="6" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border CornerRadius="7,0,0,7"
                Background="{DynamicResource AccentBrush}" />

        <Grid Grid.Column="1" Margin="18,15,15,15">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Border Width="28"
                      Height="28"
                      CornerRadius="5"
                      Background="{DynamicResource SelectedBrush}">
                <TextBlock Text="↑"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" />
              </Border>
              <StackPanel Margin="10,0,0,0">
                <TextBlock Text="UPDATE READY"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock x:Name="VersionTitle"
                           Margin="0,2,0,0"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" />
              </StackPanel>
            </StackPanel>

            <Button Grid.Column="1"
                    Width="28"
                    Height="28"
                    Content="×"
                    FontSize="17"
                    Cursor="Hand"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource MutedBrush}"
                    Click="OnDismiss"
                    AutomationProperties.Name="Dismiss update notification" />
          </Grid>

          <TextBlock Grid.Row="1"
                     Margin="38,12,8,10"
                     Text="The update was downloaded in the background. Restart ClipStack when you are ready to finish installing it."
                     FontSize="12"
                     LineHeight="18"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}" />

          <StackPanel Grid.Row="2"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right">
            <Button Content="Later"
                    Style="{StaticResource NotificationButton}"
                    Click="OnDismiss" />
            <Button Content="Restart &amp; update"
                    Style="{StaticResource PrimaryNotificationButton}"
                    Click="OnRestart"
                    AutomationProperties.Name="Restart ClipStack and install update" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
