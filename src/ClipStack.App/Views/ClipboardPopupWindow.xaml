<Window x:Class="ClipStack.Views.ClipboardPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ClipStack.Converters"
        xmlns:models="clr-namespace:ClipStack.Core.Models;assembly=ClipStack.Core"
        Title="ClipStack"
        Icon="/ClipStack;component/Assets/clipstack.ico"
        Width="442"
        Height="412"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        FontSize="14"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown"
        AutomationProperties.Name="ClipStack clipboard history">
  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="KeyHint" TargetType="Border">
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextElement.FontSize" Value="11" />
      <Setter Property="TextElement.FontWeight" Value="SemiBold" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>

    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollPageButton}"
                              Command="{x:Static ScrollBar.PageUpCommand}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="Transparent">
                        <Border x:Name="ThumbBar"
                                Margin="2,1"
                                CornerRadius="2"
                                Background="{DynamicResource MutedBrush}"
                                Opacity="0.45" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="ThumbBar" Property="Opacity" Value="1" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollPageButton}"
                              Command="{x:Static ScrollBar.PageDownCommand}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="PopupSurface" Margin="12,10,12,14">
    <Border IsHitTestVisible="False"
            Background="{DynamicResource BgBrush}"
            CornerRadius="18">
      <Border.Effect>
        <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.32" />
      </Border.Effect>
    </Border>

    <Border Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="56" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="16,0,12,0" LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource IconButton}"
                    Content="&#xE713;"
                    ToolTip="Settings"
                    Click="OnSettingsClick"
                    AutomationProperties.Name="Open settings" />
            <Button Style="{StaticResource IconButton}"
                    Content="&#xE8BB;"
                    ToolTip="Close (Esc)"
                    Click="OnCloseClick"
                    AutomationProperties.Name="Close history" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="/ClipStack;component/Assets/clipstack.ico"
                   Width="22"
                   Height="22"
                   Margin="0,0,9,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="ClipStack"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="{Binding HeaderCount}"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource MutedBrush}"
                       ToolTip="Number of clips shown" />
            <TextBlock Text="Paused"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource AccentBrush}"
                       Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Height="37"
                Margin="14,0,14,9"
                CornerRadius="9"
                BorderThickness="1"
                MouseLeftButtonDown="OnFilterSurfaceClick">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
              <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
              <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="34" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE721;"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="14" />

            <TextBox x:Name="FilterBox"
                     Grid.Column="1"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent"
                     Foreground="{DynamicResource TextBrush}"
                     CaretBrush="{DynamicResource TextBrush}"
                     SelectionBrush="{DynamicResource AccentBrush}"
                     SelectionOpacity="0.3"
                     BorderThickness="0"
                     Padding="0,0,34,0"
                     VerticalContentAlignment="Center"
                     AutomationProperties.Name="Search clipboard history">
              <TextBox.Template>
                <ControlTemplate TargetType="TextBox">
                  <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                  </Border>
                </ControlTemplate>
              </TextBox.Template>
            </TextBox>
            <TextBlock Grid.Column="1"
                       Text="Search clipboard history"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"
                       IsHitTestVisible="False"
                       Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
            <Border Grid.Column="1"
                    Style="{StaticResource KeyHint}"
                    HorizontalAlignment="Right"
                    Margin="0,0,8,0"
                    IsHitTestVisible="False"
                    Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
              <TextBlock Text="/" TextAlignment="Center" />
            </Border>
          </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="9,0,7,0">
          <ListBox x:Name="HistoryList"
                   ItemsSource="{Binding Items}"
                   SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                   Padding="0"
                   BorderThickness="0"
                   Background="Transparent"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.CanContentScroll="True"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling"
                   VirtualizingPanel.ScrollUnit="Pixel"
                   KeyboardNavigation.TabNavigation="Once"
                   PreviewMouseLeftButtonUp="OnItemClick"
                   AutomationProperties.Name="Clipboard history">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="RowSurface"
                              MinHeight="58"
                              Margin="0,0,3,2"
                              CornerRadius="9"
                              Background="Transparent">
                        <Grid>
                          <Border x:Name="SelectionIndicator"
                                  Width="3"
                                  Height="22"
                                  CornerRadius="2"
                                  Background="{DynamicResource AccentBrush}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                          <ContentPresenter Margin="9,6" />
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource SelectedBrush}" />
                          <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <Grid Width="44" Height="44" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="8"
                            ToolTip="{Binding KindLabel}">
                      <TextBlock HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource AccentBrush}"
                                 FontSize="15">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Aa" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ClipboardItemKind.RichText}">
                                <Setter Property="Text" Value="¶" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ClipboardItemKind.Files}">
                                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                                <Setter Property="Text" Value="&#xE8B7;" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ClipboardItemKind.Image}">
                                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                                <Setter Property="Text" Value="&#xE91B;" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                    <Border CornerRadius="8" Visibility="{Binding ShowThumbnail, Converter={StaticResource BoolToVis}}">
                      <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                      </Border.Background>
                    </Border>
                  </Grid>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PreviewText}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               LineHeight="18"
                               MaxHeight="36"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                      <TextBlock Text="{Binding TimeText}"
                                 FontSize="11"
                                 Foreground="{DynamicResource MutedBrush}" />
                      <TextBlock FontSize="11"
                                 Foreground="{DynamicResource MutedBrush}"
                                 Visibility="{Binding ShowThumbnail, Converter={StaticResource BoolToVis}}">
                        <Run Text=" · " /><Run Text="{Binding ImageMetaText, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Grid.Column="2" Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE718;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Margin="0,0,7,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"
                               ToolTip="Pinned"
                               Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding ShortcutLabel}"
                               Width="18"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource MutedBrush}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Text="{Binding EmptyMessage}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource MutedBrush}"
                     IsHitTestVisible="False"
                     Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
        </Grid>

        <Border Grid.Row="3"
                Margin="15,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderBrush}">
          <DockPanel LastChildFill="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Style="{StaticResource KeyHint}">
                <TextBlock Text="Enter" />
              </Border>
              <TextBlock Text="{Binding PasteAction}"
                         Margin="7,0,0,0"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Foreground="{DynamicResource TextBrush}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Style="{StaticResource KeyHint}">
                <TextBlock Text="Ctrl+P" />
              </Border>
              <TextBlock Text="Pin"
                         Margin="7,0,0,0"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
