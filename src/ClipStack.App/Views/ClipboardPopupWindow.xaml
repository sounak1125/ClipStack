<Window x:Class="ClipStack.Views.ClipboardPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ClipStack.Converters"
        Title="ClipStack"
        Icon="/ClipStack;component/Assets/clipstack.ico"
        Width="408"
        Height="360"
        MinHeight="200"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI"
        FontSize="14"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown"
        AutomationProperties.Name="ClipStack clipboard history">
  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="HeaderButton" TargetType="Button">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="2,0,0,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface"
                    Background="{TemplateBinding Background}"
                    CornerRadius="2">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FilterTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Height" Value="24" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderThickness="0"
                    CornerRadius="2">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Margin="1,1"
                    CornerRadius="2"
                    Background="{DynamicResource MutedBrush}"
                    Opacity="0.35" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Width="5" Background="Transparent">
              <Track x:Name="PART_Track"
                     IsDirectionReversed="True"
                     Focusable="False">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPageButton}"
                                Command="{x:Static ScrollBar.PageUpCommand}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPageButton}"
                                Command="{x:Static ScrollBar.PageDownCommand}" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          Background="{DynamicResource BgBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Header -->
      <Border Grid.Row="0"
              Background="{DynamicResource HeaderBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="10,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <TextBlock Text="ClipStack"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="{Binding HeaderCount}"
                       Margin="8,0,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource MutedBrush}" />
            <TextBlock Text="Paused"
                       Margin="8,0,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource MutedBrush}"
                       Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <!-- Right-aligned, so it never reads as a ratio next to the item count. -->
            <TextBlock Text="/ to filter"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Opacity="0.7"
                       Foreground="{DynamicResource MutedBrush}"
                       Visibility="{Binding ShowFilterHint, Converter={StaticResource BoolToVis}}" />
            <Button Style="{StaticResource HeaderButton}"
                    Content="⚙"
                    ToolTip="Settings"
                    Click="OnSettingsClick"
                    AutomationProperties.Name="Open settings" />
            <Button Style="{StaticResource HeaderButton}"
                    Content="×"
                    ToolTip="Close"
                    Click="OnCloseClick"
                    AutomationProperties.Name="Close" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Filter (revealed with "/" or Ctrl+F) -->
      <Border Grid.Row="1"
              Background="{DynamicResource HeaderBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="10,6"
              Visibility="{Binding IsFilterVisible, Converter={StaticResource BoolToVis}}">
        <Grid>
          <TextBox x:Name="FilterBox"
                   Style="{StaticResource FilterTextBox}"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Filter clipboard history" />
          <TextBlock Text="Filter clips…"
                     Margin="6,0,0,0"
                     VerticalAlignment="Center"
                     FontSize="13"
                     Foreground="{DynamicResource MutedBrush}"
                     IsHitTestVisible="False"
                     Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
        </Grid>
      </Border>

      <!-- List -->
      <Grid Grid.Row="2">
        <ListBox x:Name="HistoryList"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 Padding="4,2"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 PreviewMouseLeftButtonUp="OnItemClick"
                 AutomationProperties.Name="Clipboard history list">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="RowSurface"
                            MinHeight="76"
                            Margin="0"
                            Padding="10,10"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource HoverBrush}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource SelectedBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>

          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="44"
                        Height="44"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        ClipToBounds="True"
                        Visibility="{Binding ShowThumbnail, Converter={StaticResource BoolToVis}}">
                  <Image Stretch="UniformToFill"
                         Source="{Binding Thumbnail}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding PreviewText}"
                             FontSize="14"
                             LineHeight="20"
                             MaxHeight="40"
                             TextWrapping="Wrap"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextBrush}" />
                  <TextBlock Text="{Binding TimeText}"
                             Margin="0,4,0,0"
                             FontSize="11"
                             Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding ShortcutLabel}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource MutedBrush}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="{Binding EmptyMessage}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{DynamicResource MutedBrush}"
                   IsHitTestVisible="False"
                   Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
      </Grid>
    </Grid>
  </Border>
</Window>
