<Window x:Class="ClipStack.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Icon="/ClipStack;component/Assets/clipstack.ico"
        Width="640"
        Height="520"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="{DynamicResource BgBrush}"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AutomationProperties.Name="ClipStack settings">
  <Window.Resources>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style x:Key="SettingTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style x:Key="SettingRow" TargetType="Border">
      <Setter Property="Padding" Value="0,10" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="ToggleSetting" TargetType="CheckBox">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Row"
                    Padding="0,10"
                    Background="Transparent"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <ContentPresenter VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
                <Border x:Name="Track"
                        Grid.Column="1"
                        Width="36"
                        Height="20"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        CornerRadius="10"
                        Background="{DynamicResource HoverBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                  <Ellipse x:Name="Thumb"
                           Width="14"
                           Height="14"
                           Margin="2"
                           HorizontalAlignment="Left"
                           Fill="{DynamicResource MutedBrush}" />
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccentForegroundBrush}" />
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource SelectedBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Field"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="Field" Property="Background" Value="{DynamicResource HeaderBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemSurface"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource SelectedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BaseButton" TargetType="Button">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Tag" Value="Secondary" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="MinWidth" Value="88" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Tag" Value="Primary" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.92" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Surface" Property="Opacity" Value="0.88" />
                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DangerButton"
           TargetType="Button"
           BasedOn="{StaticResource BaseButton}">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style x:Key="NavigationItem" TargetType="ListBoxItem">
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="6,1" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="NavSurface" Background="Transparent">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource SelectedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Margin="2,1"
                    CornerRadius="2"
                    Background="{DynamicResource MutedBrush}"
                    Opacity="0.35" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Width="6" Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPageButton}"
                                Command="{x:Static ScrollBar.PageUpCommand}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPageButton}"
                                Command="{x:Static ScrollBar.PageDownCommand}" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
      <RowDefinition Height="52" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource HeaderBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,0">
      <TextBlock Text="Settings"
                 VerticalAlignment="Center"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextBrush}" />
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="148" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Background="{DynamicResource HeaderBrush}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ListBox x:Name="SettingsNavigation"
                   Margin="0,8,0,0"
                   BorderThickness="0"
                   Background="Transparent"
                   ItemContainerStyle="{StaticResource NavigationItem}">
            <ListBoxItem Content="General" />
            <ListBoxItem Content="Capture" />
            <ListBoxItem Content="Shortcut" />
            <ListBoxItem Content="Updates" />
            <ListBoxItem Content="Storage" />
            <ListBoxItem Content="Privacy" />
          </ListBox>
          <TextBlock x:Name="SidebarVersionText"
                     Grid.Row="1"
                     Text="0.1.0"
                     Margin="16,0,0,14"
                     FontSize="11"
                     Foreground="{DynamicResource MutedBrush}" />
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

      <Grid Grid.Column="2">
        <ScrollViewer x:Name="GeneralPage"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="24,20,24,24">
            <TextBlock Text="General" Style="{StaticResource PageTitle}" />

            <CheckBox x:Name="StartWithWindows"
                      Style="{StaticResource ToggleSetting}"
                      AutomationProperties.Name="Start with Windows">
              <TextBlock Text="Start with Windows" Style="{StaticResource SettingTitle}" />
            </CheckBox>

            <CheckBox x:Name="AutoPaste"
                      Style="{StaticResource ToggleSetting}"
                      AutomationProperties.Name="Auto-paste">
              <TextBlock Text="Auto-paste" Style="{StaticResource SettingTitle}" />
            </CheckBox>

            <CheckBox x:Name="ShowNotifications"
                      Style="{StaticResource ToggleSetting}"
                      AutomationProperties.Name="Notifications">
              <TextBlock Text="Notifications" Style="{StaticResource SettingTitle}" />
            </CheckBox>

            <CheckBox x:Name="ClearOnExit"
                      Style="{StaticResource ToggleSetting}"
                      AutomationProperties.Name="Clear on exit">
              <TextBlock Text="Clear on exit" Style="{StaticResource SettingTitle}" />
            </CheckBox>

            <Border Style="{StaticResource SettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Appearance" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" />
                <ComboBox x:Name="ThemeCombo"
                          Grid.Column="1"
                          SelectionChanged="OnThemeSelectionChanged"
                          AutomationProperties.Name="Appearance theme">
                  <ComboBoxItem Content="Dark" Tag="Dark" />
                  <ComboBoxItem Content="Light" Tag="Light" />
                  <ComboBoxItem Content="Dim" Tag="Dim" />
                  <ComboBoxItem Content="Contrast" Tag="Contrast" />
                </ComboBox>
              </Grid>
            </Border>

            <Border Style="{StaticResource SettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="History limit" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" />
                <TextBox x:Name="HistoryLimit"
                         Grid.Column="1"
                         LostFocus="OnHistoryLimitLostFocus"
                         AutomationProperties.Name="History limit" />
              </Grid>
            </Border>

            <Border Style="{StaticResource SettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Max size (MB)" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" />
                <TextBox x:Name="MaxSizeMb"
                         Grid.Column="1"
                         AutomationProperties.Name="Maximum item size in megabytes" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="CapturePage"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="24,20,24,24">
            <TextBlock Text="Capture" Style="{StaticResource PageTitle}" />

            <CheckBox x:Name="CaptureEnabled"
                      Style="{StaticResource ToggleSetting}"
                      AutomationProperties.Name="Monitoring">
              <TextBlock Text="Monitoring" Style="{StaticResource SettingTitle}" />
            </CheckBox>

            <CheckBox x:Name="CaptureText"
                      Style="{StaticResource ToggleSetting}"
                      AutomationProperties.Name="Text">
              <TextBlock Text="Text" Style="{StaticResource SettingTitle}" />
            </CheckBox>

            <CheckBox x:Name="CaptureRichText"
                      Style="{StaticResource ToggleSetting}"
                      AutomationProperties.Name="Rich text">
              <TextBlock Text="Rich text" Style="{StaticResource SettingTitle}" />
            </CheckBox>

            <CheckBox x:Name="CaptureImages"
                      Style="{StaticResource ToggleSetting}"
                      AutomationProperties.Name="Images">
              <TextBlock Text="Images" Style="{StaticResource SettingTitle}" />
            </CheckBox>

            <CheckBox x:Name="CaptureFiles"
                      Style="{StaticResource ToggleSetting}"
                      AutomationProperties.Name="Files">
              <TextBlock Text="Files" Style="{StaticResource SettingTitle}" />
            </CheckBox>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ShortcutPage"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="24,20,24,24">
            <TextBlock Text="Shortcut" Style="{StaticResource PageTitle}" />

            <TextBlock Text="Global shortcut"
                       Style="{StaticResource SettingTitle}"
                       Margin="0,0,0,8" />

            <Border x:Name="ShortcutRecorderHost"
                    MinHeight="36"
                    Padding="10,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Cursor="Hand"
                    Focusable="True"
                    FocusVisualStyle="{x:Null}"
                    ToolTip="Click, then press a new shortcut"
                    GotKeyboardFocus="OnShortcutRecorderGotFocus"
                    LostKeyboardFocus="OnShortcutRecorderLostFocus"
                    PreviewMouseLeftButtonDown="OnShortcutRecorderMouseDown"
                    PreviewKeyDown="OnShortcutPreviewKeyDown"
                    PreviewKeyUp="OnShortcutPreviewKeyUp"
                    AutomationProperties.Name="Shortcut recorder">
              <TextBlock x:Name="ShortcutRecorderText"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextBrush}" />
            </Border>

            <TextBlock x:Name="ShortcutHint"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource MutedBrush}"
                       Text="Click the field, then press a new shortcut." />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="Apply"
                      Style="{StaticResource PrimaryButton}"
                      Click="OnApplyShortcut" />
              <Button Content="Default"
                      Margin="8,0,0,0"
                      Style="{StaticResource BaseButton}"
                      Click="OnRestoreDefaultShortcut" />
            </StackPanel>
            <TextBlock x:Name="ShortcutError"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="UpdatesPage"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="24,20,24,24">
            <TextBlock Text="Updates" Style="{StaticResource PageTitle}" />

            <CheckBox x:Name="AutoUpdates"
                      Style="{StaticResource ToggleSetting}"
                      AutomationProperties.Name="Auto-check">
              <TextBlock Text="Auto-check" Style="{StaticResource SettingTitle}" />
            </CheckBox>

            <Border Style="{StaticResource SettingRow}">
              <StackPanel>
                <TextBlock x:Name="VersionText"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="FeedStatusText"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="UpdateStatusText"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Button Content="Check"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource BaseButton}"
                    Click="OnCheckUpdates" />
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="StoragePage"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="24,20,24,24">
            <TextBlock Text="Storage" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource SettingRow}">
              <StackPanel>
                <TextBlock Text="Folder" Style="{StaticResource SettingTitle}" />
                <TextBlock x:Name="DataFolderText"
                           Margin="0,6,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingRow}">
              <StackPanel>
                <TextBlock Text="Usage" Style="{StaticResource SettingTitle}" />
                <TextBlock x:Name="DiskUsageText"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button Content="Open folder"
                      Style="{StaticResource BaseButton}"
                      Click="OnOpenDataFolder" />
              <Button Content="Clear history"
                      Margin="8,0,0,0"
                      Style="{StaticResource DangerButton}"
                      Click="OnClearHistory" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="PrivacyPage"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="24,20,24,24">
            <TextBlock Text="Privacy" Style="{StaticResource PageTitle}" />
            <TextBlock Text="History stays on this device. Nothing is uploaded."
                       FontSize="13"
                       LineHeight="20"
                       Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Border Grid.Row="2"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,0">
      <StackPanel HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Orientation="Horizontal">
        <Button Content="Cancel"
                Margin="0,0,8,0"
                Style="{StaticResource BaseButton}"
                Click="OnCancel" />
        <Button Content="Save"
                IsDefault="True"
                Style="{StaticResource PrimaryButton}"
                Click="OnSave" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
