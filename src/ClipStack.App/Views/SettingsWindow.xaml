<Window x:Class="ClipStack.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipStack Settings"
        Icon="/ClipStack;component/Assets/clipstack.ico"
        Width="820"
        Height="720"
        MinWidth="700"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Background="{DynamicResource BgBrush}"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AutomationProperties.Name="ClipStack settings">
  <Window.Resources>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style x:Key="PageDescription" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,5,0,22" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="GroupLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,19,0,4" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style x:Key="SettingTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style x:Key="SettingDescription" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingRow" TargetType="Border">
      <Setter Property="Padding" Value="0,14" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="ToggleSetting" TargetType="CheckBox">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Row"
                    Padding="0,14"
                    Background="Transparent"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <ContentPresenter VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
                <Border x:Name="Track"
                        Grid.Column="1"
                        Width="40"
                        Height="22"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        CornerRadius="11"
                        Background="{DynamicResource HoverBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                  <Ellipse x:Name="Thumb"
                           Width="16"
                           Height="16"
                           Margin="2"
                           HorizontalAlignment="Left"
                           Fill="{DynamicResource MutedBrush}" />
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccentForegroundBrush}" />
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Field"
                    CornerRadius="5"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Field" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="Field" Property="Background" Value="{DynamicResource HeaderBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BaseButton" TargetType="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Tag" Value="Secondary" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface"
                    CornerRadius="5"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True" />
                  <Condition Property="Tag" Value="Secondary" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </MultiTrigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsPressed" Value="True" />
                  <Condition Property="Tag" Value="Secondary" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedBrush}" />
              </MultiTrigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True" />
                  <Condition Property="Tag" Value="Primary" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Surface" Property="Opacity" Value="0.9" />
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton"
           TargetType="Button"
           BasedOn="{StaticResource BaseButton}">
      <Setter Property="MinWidth" Value="112" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
      <Setter Property="Tag" Value="Primary" />
    </Style>

    <Style x:Key="DangerButton"
           TargetType="Button"
           BasedOn="{StaticResource BaseButton}">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style x:Key="NavigationItem" TargetType="ListBoxItem">
      <Setter Property="Height" Value="42" />
      <Setter Property="Margin" Value="8,1" />
      <Setter Property="Padding" Value="13,0" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="NavSurface"
                    CornerRadius="4"
                    Background="Transparent">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Indicator"
                        Width="3"
                        Height="20"
                        CornerRadius="1"
                        Background="{DynamicResource AccentBrush}"
                        Opacity="0" />
                <ContentPresenter Grid.Column="1"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource SelectedBrush}" />
                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Margin="2,1"
                    CornerRadius="2"
                    Background="{DynamicResource MutedBrush}"
                    Opacity="0.42" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Width="7" Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPageButton}"
                                Command="{x:Static ScrollBar.PageUpCommand}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPageButton}"
                                Command="{x:Static ScrollBar.PageDownCommand}" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="68" />
      <RowDefinition Height="*" />
      <RowDefinition Height="64" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource HeaderBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="22,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="5" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="4"
                Height="30"
                CornerRadius="1"
                Background="{DynamicResource AccentBrush}" />
        <StackPanel Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
          <TextBlock Text="CLIPSTACK / SETTINGS"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="12"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextBrush}" />
          <TextBlock Text="Clipboard utility configuration"
                     Margin="0,4,0,0"
                     FontSize="11"
                     Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>
        <TextBlock Grid.Column="2"
                   Text="LOCAL SYSTEM UTILITY"
                   VerticalAlignment="Center"
                   FontFamily="Cascadia Mono, Consolas"
                   FontSize="9.5"
                   Foreground="{DynamicResource MutedBrush}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Background="{DynamicResource HeaderBrush}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="SECTIONS"
                     Margin="21,20,0,10"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="9.5"
                     FontWeight="Bold"
                     Foreground="{DynamicResource MutedBrush}" />
          <ListBox x:Name="SettingsNavigation"
                   Grid.Row="1"
                   BorderThickness="0"
                   Background="Transparent"
                   ItemContainerStyle="{StaticResource NavigationItem}">
            <ListBoxItem Content="General" />
            <ListBoxItem Content="Capture" />
            <ListBoxItem Content="Shortcut" />
            <ListBoxItem Content="Updates" />
            <ListBoxItem Content="Storage" />
            <ListBoxItem Content="Privacy" />
          </ListBox>
          <TextBlock x:Name="SidebarVersionText"
                     Grid.Row="2"
                     Text="ClipStack 0.1"
                     Margin="21,0,0,18"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="9.5"
                     Foreground="{DynamicResource MutedBrush}" />
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

      <Grid Grid.Column="2">
        <ScrollViewer x:Name="GeneralPage"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,27,34,30">
            <TextBlock Text="General" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Control how ClipStack starts and behaves."
                       Style="{StaticResource PageDescription}" />

            <TextBlock Text="BEHAVIOR" Style="{StaticResource GroupLabel}" Margin="0,0,0,4" />

            <CheckBox x:Name="StartWithWindows"
                      Style="{StaticResource ToggleSetting}"
                      AutomationProperties.Name="Start with Windows">
              <StackPanel>
                <TextBlock Text="Start with Windows" Style="{StaticResource SettingTitle}" />
                <TextBlock Text="Launch ClipStack automatically when you sign in."
                           Style="{StaticResource SettingDescription}" />
              </StackPanel>
            </CheckBox>

            <CheckBox x:Name="AutoPaste"
                      Style="{StaticResource ToggleSetting}"
                      AutomationProperties.Name="Paste immediately">
              <StackPanel>
                <TextBlock Text="Paste immediately" Style="{StaticResource SettingTitle}" />
                <TextBlock Text="Paste the selected clip into the application you were using."
                           Style="{StaticResource SettingDescription}" />
              </StackPanel>
            </CheckBox>

            <CheckBox x:Name="ShowNotifications"
                      Style="{StaticResource ToggleSetting}"
                      AutomationProperties.Name="Tray notifications">
              <StackPanel>
                <TextBlock Text="Tray notifications" Style="{StaticResource SettingTitle}" />
                <TextBlock Text="Show status and fallback messages near the system tray."
                           Style="{StaticResource SettingDescription}" />
              </StackPanel>
            </CheckBox>

            <CheckBox x:Name="ClearOnExit"
                      Style="{StaticResource ToggleSetting}"
                      AutomationProperties.Name="Clear history on exit">
              <StackPanel>
                <TextBlock Text="Clear history on exit" Style="{StaticResource SettingTitle}" />
                <TextBlock Text="Delete saved clipboard items whenever ClipStack closes."
                           Style="{StaticResource SettingDescription}" />
              </StackPanel>
            </CheckBox>

            <TextBlock Text="LIMITS" Style="{StaticResource GroupLabel}" />

            <Border Style="{StaticResource SettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="History limit" Style="{StaticResource SettingTitle}" />
                  <TextBlock Text="Number of recent items to retain, from 1 to 50."
                             Style="{StaticResource SettingDescription}" />
                </StackPanel>
                <TextBox x:Name="HistoryLimit"
                         Grid.Column="1"
                         FontFamily="Cascadia Mono, Consolas"
                         AutomationProperties.Name="History limit"
                         ToolTip="Number of clipboard items to keep" />
              </Grid>
            </Border>

            <Border Style="{StaticResource SettingRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Maximum item size" Style="{StaticResource SettingTitle}" />
                  <TextBlock Text="Megabytes per item. Enter 0 for unlimited."
                             Style="{StaticResource SettingDescription}" />
                </StackPanel>
                <TextBox x:Name="MaxSizeMb"
                         Grid.Column="1"
                         FontFamily="Cascadia Mono, Consolas"
                         AutomationProperties.Name="Maximum item size in megabytes"
                         ToolTip="Maximum item size in megabytes" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="CapturePage"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,27,34,30">
            <TextBlock Text="Capture" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Turn monitoring on or off and choose what is remembered."
                       Style="{StaticResource PageDescription}" />

            <TextBlock Text="MASTER CONTROL" Style="{StaticResource GroupLabel}" Margin="0,0,0,4" />

            <CheckBox x:Name="CaptureEnabled"
                      Style="{StaticResource ToggleSetting}"
                      AutomationProperties.Name="Clipboard monitoring">
              <StackPanel>
                <TextBlock Text="Clipboard monitoring" Style="{StaticResource SettingTitle}" />
                <TextBlock Text="When off, existing history remains available but new clips are ignored."
                           Style="{StaticResource SettingDescription}" />
              </StackPanel>
            </CheckBox>

            <TextBlock Text="CONTENT TYPES" Style="{StaticResource GroupLabel}" />

            <CheckBox x:Name="CaptureText"
                      Style="{StaticResource ToggleSetting}"
                      AutomationProperties.Name="Capture plain text">
              <StackPanel>
                <TextBlock Text="Plain text" Style="{StaticResource SettingTitle}" />
                <TextBlock Text="Words, code, links, and other Unicode text."
                           Style="{StaticResource SettingDescription}" />
              </StackPanel>
            </CheckBox>

            <CheckBox x:Name="CaptureRichText"
                      Style="{StaticResource ToggleSetting}"
                      AutomationProperties.Name="Capture rich text">
              <StackPanel>
                <TextBlock Text="Rich text" Style="{StaticResource SettingTitle}" />
                <TextBlock Text="HTML and RTF formatting alongside a plain-text fallback."
                           Style="{StaticResource SettingDescription}" />
              </StackPanel>
            </CheckBox>

            <CheckBox x:Name="CaptureImages"
                      Style="{StaticResource ToggleSetting}"
                      AutomationProperties.Name="Capture images">
              <StackPanel>
                <TextBlock Text="Images" Style="{StaticResource SettingTitle}" />
                <TextBlock Text="Screenshots and bitmap clipboard content."
                           Style="{StaticResource SettingDescription}" />
              </StackPanel>
            </CheckBox>

            <CheckBox x:Name="CaptureFiles"
                      Style="{StaticResource ToggleSetting}"
                      AutomationProperties.Name="Capture files and folders">
              <StackPanel>
                <TextBlock Text="Files and folders" Style="{StaticResource SettingTitle}" />
                <TextBlock Text="Remember file paths copied from File Explorer."
                           Style="{StaticResource SettingDescription}" />
              </StackPanel>
            </CheckBox>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ShortcutPage"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,27,34,30">
            <TextBlock Text="Shortcut" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Choose the global key combination that opens your clipboard."
                       Style="{StaticResource PageDescription}" />

            <TextBlock Text="CURRENT" Style="{StaticResource GroupLabel}" Margin="0,0,0,9" />
            <Border Padding="16,14"
                    CornerRadius="5"
                    Background="{DynamicResource HeaderBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
              <TextBlock x:Name="CurrentShortcut"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="15"
                         FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}" />
            </Border>

            <TextBlock Text="RECORD A SHORTCUT" Style="{StaticResource GroupLabel}" />
            <TextBlock Text="Click the field, then press a modifier and key together."
                       Margin="0,0,0,9"
                       FontSize="11"
                       Foreground="{DynamicResource MutedBrush}" />
            <TextBox x:Name="ShortcutRecorder"
                     FontFamily="Cascadia Mono, Consolas"
                     IsReadOnly="True"
                     PreviewKeyDown="OnShortcutPreviewKeyDown"
                     AutomationProperties.Name="Shortcut recorder" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="Apply shortcut"
                      Style="{StaticResource PrimaryButton}"
                      Click="OnApplyShortcut" />
              <Button Content="Restore default"
                      Margin="8,0,0,0"
                      Style="{StaticResource BaseButton}"
                      Click="OnRestoreDefaultShortcut" />
            </StackPanel>
            <TextBlock x:Name="ShortcutError"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />

            <TextBlock Text="QUICK PASTE" Style="{StaticResource GroupLabel}" />
            <TextBlock Text="Inside the clipboard window, press 1–9 to paste that numbered item immediately. Press 0 for item 10."
                       FontSize="12"
                       LineHeight="20"
                       Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="UpdatesPage"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,27,34,30">
            <TextBlock Text="Updates" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Control update checks and view the current release status."
                       Style="{StaticResource PageDescription}" />

            <TextBlock Text="PREFERENCES" Style="{StaticResource GroupLabel}" Margin="0,0,0,4" />
            <CheckBox x:Name="AutoUpdates"
                      Style="{StaticResource ToggleSetting}"
                      AutomationProperties.Name="Automatic update checks">
              <StackPanel>
                <TextBlock Text="Download updates automatically" Style="{StaticResource SettingTitle}" />
                <TextBlock Text="While ClipStack is open, check GitHub in the background and download new versions. You choose when to restart."
                           Style="{StaticResource SettingDescription}" />
              </StackPanel>
            </CheckBox>

            <TextBlock Text="STATUS" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource SettingRow}">
              <StackPanel>
                <TextBlock x:Name="VersionText"
                           FontFamily="Cascadia Mono, Consolas"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="FeedStatusText"
                           Margin="0,7,0,0"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="UpdateStatusText"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Button Content="Check for updates"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource BaseButton}"
                    Click="OnCheckUpdates" />
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="StoragePage"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,27,34,30">
            <TextBlock Text="Storage" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Inspect and manage ClipStack’s local data."
                       Style="{StaticResource PageDescription}" />

            <TextBlock Text="LOCAL DATA" Style="{StaticResource GroupLabel}" Margin="0,0,0,4" />
            <Border Style="{StaticResource SettingRow}">
              <StackPanel>
                <TextBlock Text="Data directory" Style="{StaticResource SettingTitle}" />
                <TextBlock x:Name="DataFolderText"
                           Margin="0,7,0,0"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingRow}">
              <StackPanel>
                <TextBlock Text="History usage" Style="{StaticResource SettingTitle}" />
                <TextBlock x:Name="DiskUsageText"
                           Margin="0,7,0,0"
                           FontFamily="Cascadia Mono, Consolas"
                           Foreground="{DynamicResource AccentBrush}" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Content="Open data folder"
                      Style="{StaticResource BaseButton}"
                      Click="OnOpenDataFolder" />
              <Button Content="Clear all history"
                      Margin="8,0,0,0"
                      Style="{StaticResource DangerButton}"
                      Click="OnClearHistory" />
            </StackPanel>

            <TextBlock Text="WHAT IS STORED" Style="{StaticResource GroupLabel}" />
            <TextBlock Text="ClipStack stores an index plus separate payload files for text, rich text, image data, thumbnails, and file-path lists."
                       FontSize="12"
                       LineHeight="20"
                       Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="PrivacyPage"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,27,34,30">
            <TextBlock Text="Privacy" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Your clipboard should remain yours."
                       Style="{StaticResource PageDescription}" />

            <Border Padding="18,16"
                    CornerRadius="5"
                    Background="{DynamicResource SelectedBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="5" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="4"
                        CornerRadius="1"
                        Background="{DynamicResource AccentBrush}" />
                <StackPanel Grid.Column="1" Margin="13,0,0,0">
                  <TextBlock Text="LOCAL BY DESIGN"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="11"
                             FontWeight="Bold"
                             Foreground="{DynamicResource TextBrush}" />
                  <TextBlock Text="Clipboard history is stored only on this device. ClipStack does not upload or synchronize clipboard contents."
                             Margin="0,8,0,0"
                             LineHeight="20"
                             Foreground="{DynamicResource MutedBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock Text="NETWORK ACCESS" Style="{StaticResource GroupLabel}" />
            <TextBlock Text="The application only makes a network request when an update feed is configured and an update check runs. Clipboard contents are never included."
                       FontSize="12"
                       LineHeight="20"
                       Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap" />

            <TextBlock Text="LOGS" Style="{StaticResource GroupLabel}" />
            <TextBlock Text="Diagnostic logs contain operation names and sanitized errors. ClipStack does not intentionally write clipboard contents into its logs."
                       FontSize="12"
                       LineHeight="20"
                       Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Border Grid.Row="2"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="22,0">
      <Grid>
        <TextBlock Text="Settings are stored on this device."
                   VerticalAlignment="Center"
                   FontFamily="Cascadia Mono, Consolas"
                   FontSize="9.5"
                   Foreground="{DynamicResource MutedBrush}" />
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
          <Button Content="Cancel"
                  Margin="0,0,8,0"
                  Style="{StaticResource BaseButton}"
                  Click="OnCancel" />
          <Button Content="Save changes"
                  IsDefault="True"
                  Style="{StaticResource PrimaryButton}"
                  Click="OnSave" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
