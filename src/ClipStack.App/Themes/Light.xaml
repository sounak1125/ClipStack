<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="BgColor">#FFFAFAFA</Color>
  <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
  <Color x:Key="BorderColor">#FFE5E5E5</Color>
  <Color x:Key="TextColor">#FF1A1A1A</Color>
  <Color x:Key="MutedColor">#FF999999</Color>
  <Color x:Key="AccentColor">#FFD65F32</Color>
  <Color x:Key="AccentForegroundColor">#FFFFFFFF</Color>
  <Color x:Key="DangerColor">#FFD32F2F</Color>
  <Color x:Key="SelectedColor">#FFF0F0F0</Color>
  <Color x:Key="HoverColor">#FFF5F5F5</Color>
  <Color x:Key="HeaderColor">#FFFAFAFA</Color>
  <Color x:Key="TextKindColor">#FFD65F32</Color>
  <Color x:Key="RichTextKindColor">#FF9B62B0</Color>
  <Color x:Key="ImageKindColor">#FF258C82</Color>
  <Color x:Key="FilesKindColor">#FFB07816</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
  <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource HeaderColor}" />
  <SolidColorBrush x:Key="TextKindBrush" Color="{StaticResource TextKindColor}" />
  <SolidColorBrush x:Key="RichTextKindBrush" Color="{StaticResource RichTextKindColor}" />
  <SolidColorBrush x:Key="ImageKindBrush" Color="{StaticResource ImageKindColor}" />
  <SolidColorBrush x:Key="FilesKindBrush" Color="{StaticResource FilesKindColor}" />
</ResourceDictionary>
